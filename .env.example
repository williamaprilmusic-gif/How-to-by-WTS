# How To — by WTS: environment variables
# Copy to .env.local for local dev, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.
# All values below are placeholders — never commit real keys.

# ── LLM provider API keys ──────────────────────────────────────────────
# Add at least one. The generator uses whichever keys are present and
# round-robins across all of them. Free sign-up links in the README.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Provider selection (optional) ──────────────────────────────────────
# Unset or "auto" = round-robin across every provider that has a key.
# Set to cerebras | groq | gemini to pin one as primary (others fall back).
LLM_PROVIDER=auto

# ── Model overrides (optional) ─────────────────────────────────────────
# Defaults: cerebras=llama-3.3-70b, groq=llama-3.3-70b-versatile,
#           gemini=gemini-3.8-flash
CEREBRAS_MODEL=
GROQ_MODEL=
GEMINI_MODEL=

# ── KV store for round-robin + cooldown memory (optional) ──────────────
# Connect a Vercel KV / Upstash Redis store to the project and these are
# injected automatically. Without them the generator still works (fixed
# order, no cross-request cooldown memory). Either pair is accepted:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
