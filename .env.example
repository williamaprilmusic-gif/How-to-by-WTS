# How To — by WTS: environment variables
# Copy to .env.local for local dev, or set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.
# All values below are placeholders — never commit real keys.

# ── LLM provider API keys ──────────────────────────────────────────────
# Add at least one. The generator uses whichever keys are present and
# round-robins across all of them. Free sign-up links in the README.
GROQ_API_KEY=            # console.groq.com
GEMINI_API_KEY=          # aistudio.google.com
CEREBRAS_API_KEY=        # cloud.cerebras.ai
OPENROUTER_API_KEY=      # openrouter.ai
MISTRAL_API_KEY=         # console.mistral.ai
NVIDIA_API_KEY=          # build.nvidia.com

# ── Provider selection (optional) ──────────────────────────────────────
# Unset or "auto" = round-robin across every provider that has a key.
# Set to a provider name to pin it as primary (others fall back):
# groq | gemini | cerebras | openrouter | mistral | nvidia | custom
LLM_PROVIDER=auto

# ── Model overrides (optional) ─────────────────────────────────────────
# Each provider has a sensible default (see README); override here if you like.
GROQ_MODEL=
GEMINI_MODEL=
CEREBRAS_MODEL=
OPENROUTER_MODEL=
MISTRAL_MODEL=
NVIDIA_MODEL=

# ── Custom OpenAI-compatible provider (optional) ───────────────────────
# Point at any OpenAI-compatible /chat/completions endpoint. Active only
# when both URL and key are set. Set CUSTOM_LLM_JSON=1 to request JSON mode.
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_JSON=

# ── KV store for round-robin + cooldown memory (optional) ──────────────
# Connect a Vercel KV / Upstash Redis store to the project and these are
# injected automatically. Without them the generator still works (fixed
# order, no cross-request cooldown memory). Either pair is accepted:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
